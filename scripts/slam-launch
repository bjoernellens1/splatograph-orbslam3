#!/usr/bin/env bash
# Headless ORB-SLAM3 launch — RGB-D (default) or Monocular (legacy).
#
# SLAM_MODE=rgbd  (default): rgbd_node_cpp subscribes directly to color+depth.
#                             No Python driver or adapter needed.
# SLAM_MODE=mono  (legacy):  mono_node_cpp + mono_driver_node.py + adapter.
#
# Env vars (with defaults):
#   SLAM_MODE          - "rgbd" or "mono"  (default rgbd)
#   RGBD_SYNCED_TOPIC  - splatograph_rgbd_msgs/RGBDSynced topic (default
#                         /camera/rgbd_synced; rgbd/rgbd_inertial only).
#                         Migrated 2026-08-23 (#3): rgbd_node_cpp and
#                         rgbd_inertial_node_cpp no longer subscribe to
#                         independent color/depth topics -- they consume the
#                         single already-paired RGBDSynced message published
#                         by splatograph-rgbd-sync's SyncNode.
#   RUN_SYNC_NODE      - "1" (default) launches splatograph_rgbd_sync's
#                         sync_node in-container, fed by CAMERA_COLOR_TOPIC/
#                         CAMERA_DEPTH_TOPIC/CAMERA_IMU_TOPIC/the two
#                         *_INFO_TOPIC vars below, remapped to publish
#                         RGBD_SYNCED_TOPIC. Set "0" when RGBD_SYNCED_TOPIC is
#                         already published by something else upstream (e.g.
#                         a shared sync_node run once for multiple consumers,
#                         or a validated hardware-synced source doing
#                         assert-only verification per that repo's README) --
#                         this container then only subscribes.
#   CAMERA_COLOR_TOPIC / CAMERA_DEPTH_TOPIC / CAMERA_IMU_TOPIC
#                      - raw sync_node inputs (defaults /camera/color/image_raw,
#                        /camera/depth/image_raw, /camera/imu)
#   CAMERA_COLOR_INFO_TOPIC / CAMERA_DEPTH_INFO_TOPIC
#                      - CameraInfo inputs (defaults /camera/color/camera_info,
#                        /camera/depth/camera_info) -- sync_node drops every
#                        pair until both have arrived at least once (see
#                        splatograph-rgbd-sync's README).
#   IMAGE_TOPIC        - raw colour image topic (mono mode only; legacy)
#   CAMERA_CONFIG_NAME - yaml basename without .yaml  (default OrbbecFemtoMega_RGBD / RealSense_D435i)
#   CAMERA_CONFIG_DIR  - directory containing <CAMERA_CONFIG_NAME>.yaml (default /config/)
#   CAMERA_CONFIG_PATH - if set, overrides DIR+NAME; must end in .yaml
#   VOCABULARY         - ORB vocabulary file
#   ROS_DOMAIN_ID      - DDS domain (default 0)
#   RMW_IMPLEMENTATION - DDS impl (default rmw_fastrtps_cpp)
set -eo pipefail

: "${ROS_DOMAIN_ID:=0}"
export ROS_DOMAIN_ID
export RMW_IMPLEMENTATION="${RMW_IMPLEMENTATION:-rmw_fastrtps_cpp}"

source /opt/ros/${ROS_DISTRO:-jazzy}/setup.bash
source /opt/rgbd_sync_ws/install/setup.bash
source /opt/orbslam3_ws/install/setup.bash

export LD_LIBRARY_PATH="/opt/ros/${ROS_DISTRO:-jazzy}/lib:/opt/rgbd_sync_ws/install/lib:/opt/orbslam3_ws/install/lib:${LD_LIBRARY_PATH:-}"
export LD_LIBRARY_PATH="/usr/local/lib:${LD_LIBRARY_PATH}"

# Translate CAMERA_CONFIG_PATH (full file path) into CAMERA_CONFIG_DIR+NAME
SLAM_MODE=${SLAM_MODE:-rgbd}
IMAGE_TOPIC=${IMAGE_TOPIC:-/camera/color/image_raw}
RGBD_SYNCED_TOPIC=${RGBD_SYNCED_TOPIC:-/camera/rgbd_synced}

if [ "${SLAM_MODE}" = "rgbd" ]; then
    CAMERA_CONFIG_NAME=${CAMERA_CONFIG_NAME:-OrbbecFemtoMega_RGBD}
else
    CAMERA_CONFIG_NAME=${CAMERA_CONFIG_NAME:-RealSense_D435i}
fi
CAMERA_CONFIG_DIR=${CAMERA_CONFIG_DIR:-/config/}

if [ -n "${CAMERA_CONFIG_PATH:-}" ]; then
  case "${CAMERA_CONFIG_PATH}" in
    *.yaml)
      CAMERA_CONFIG_DIR="$(dirname "${CAMERA_CONFIG_PATH}")/"
      CAMERA_CONFIG_NAME="$(basename "${CAMERA_CONFIG_PATH}" .yaml)"
      ;;
    *)
      echo "slam-launch: CAMERA_CONFIG_PATH must end in .yaml (got: ${CAMERA_CONFIG_PATH})" >&2
      exit 2
      ;;
  esac
fi

VOCABULARY=${VOCABULARY:-/opt/orbslam3_ws/src/ros2_orb_slam3/orb_slam3/Vocabulary/ORBvoc.txt.bin}

RUN_SYNC_NODE=${RUN_SYNC_NODE:-1}
CAMERA_COLOR_TOPIC=${CAMERA_COLOR_TOPIC:-/camera/color/image_raw}
CAMERA_DEPTH_TOPIC=${CAMERA_DEPTH_TOPIC:-/camera/depth/image_raw}
CAMERA_IMU_TOPIC=${CAMERA_IMU_TOPIC:-/camera/imu}
CAMERA_COLOR_INFO_TOPIC=${CAMERA_COLOR_INFO_TOPIC:-/camera/color/camera_info}
CAMERA_DEPTH_INFO_TOPIC=${CAMERA_DEPTH_INFO_TOPIC:-/camera/depth/camera_info}
SYNC_NODE=/opt/rgbd_sync_ws/install/lib/splatograph_rgbd_sync/sync_node
sync_pid=""

# splatograph_rgbd_sync's SyncNode is the sole authoritative pairing owner
# (splatograph's CLAUDE.md HARD CONSTRAINT + that repo's own README topology)
# -- rgbd_node_cpp/rgbd_inertial_node_cpp deliberately do their own pairing
# work no more. Launched in the background here so this container's existing
# single-process bag-replay/live topology keeps working without requiring a
# second container; RUN_SYNC_NODE=0 opts out when something else already
# publishes RGBD_SYNCED_TOPIC.
start_sync_node() {
    if [ "${RUN_SYNC_NODE}" != "1" ]; then
        echo "slam-launch: RUN_SYNC_NODE=0, expecting ${RGBD_SYNCED_TOPIC} to already be published externally"
        return
    fi
    echo "slam-launch: sync_node  color=${CAMERA_COLOR_TOPIC} depth=${CAMERA_DEPTH_TOPIC} imu=${CAMERA_IMU_TOPIC} -> ${RGBD_SYNCED_TOPIC}"
    "${SYNC_NODE}" --ros-args \
      -p color_topic:=${CAMERA_COLOR_TOPIC} \
      -p depth_topic:=${CAMERA_DEPTH_TOPIC} \
      -p imu_topic:=${CAMERA_IMU_TOPIC} \
      -p color_camera_info_topic:=${CAMERA_COLOR_INFO_TOPIC} \
      -p depth_camera_info_topic:=${CAMERA_DEPTH_INFO_TOPIC} \
      -r rgbd_synced:=${RGBD_SYNCED_TOPIC} &
    sync_pid=$!
}

# ── RGB-D mode ──────────────────────────────────────────────────────────────
if [ "${SLAM_MODE}" = "rgbd" ]; then
    RGBD_CPP=/opt/orbslam3_ws/install/lib/ros2_orb_slam3/rgbd_node_cpp
    echo "slam-launch: RGB-D mode  rgbd_synced=${RGBD_SYNCED_TOPIC}"
    echo "slam-launch: config=${CAMERA_CONFIG_DIR}${CAMERA_CONFIG_NAME}.yaml"
    start_sync_node
    trap 'kill "${sync_pid}" 2>/dev/null || true' EXIT
    "${RGBD_CPP}" --ros-args \
      -p voc_file_arg:=${VOCABULARY} \
      -p settings_file_path_arg:=${CAMERA_CONFIG_DIR} \
      -p settings_name_arg:=${CAMERA_CONFIG_NAME} \
      -p rgbd_synced_topic:=${RGBD_SYNCED_TOPIC}
    exit $?
fi

LIB=/opt/orbslam3_ws/install/lib/ros2_orb_slam3
IMU_TOPIC=${IMU_TOPIC:-/camera/imu}
LEFT_TOPIC=${LEFT_TOPIC:-/camera/infra1/image_rect_raw}
RIGHT_TOPIC=${RIGHT_TOPIC:-/camera/infra2/image_rect_raw}

# ── RGB-D-Inertial mode (Orbbec Femto VIO: colour + depth + IMU) ─────────────
# IMU samples arrive packaged inside RGBDSynced.imu_samples (no separate
# imu_topic subscription any more -- see rgbd_inertial_example.cpp's own
# migration comment).
if [ "${SLAM_MODE}" = "rgbd_inertial" ] || [ "${SLAM_MODE}" = "vio_rgbd" ]; then
    echo "slam-launch: RGBD-Inertial  rgbd_synced=${RGBD_SYNCED_TOPIC}  config=${CAMERA_CONFIG_DIR}${CAMERA_CONFIG_NAME}.yaml"
    start_sync_node
    trap 'kill "${sync_pid}" 2>/dev/null || true' EXIT
    "${LIB}/rgbd_inertial_node_cpp" --ros-args \
      -p voc_file_arg:=${VOCABULARY} \
      -p settings_file_path_arg:=${CAMERA_CONFIG_DIR} \
      -p settings_name_arg:=${CAMERA_CONFIG_NAME} \
      -p rgbd_synced_topic:=${RGBD_SYNCED_TOPIC}
    exit $?
fi

# ── Stereo mode (RealSense D435i left/right IR; emitter OFF) ─────────────────
if [ "${SLAM_MODE}" = "stereo" ]; then
    echo "slam-launch: Stereo  left=${LEFT_TOPIC} right=${RIGHT_TOPIC}  config=${CAMERA_CONFIG_DIR}${CAMERA_CONFIG_NAME}.yaml"
    "${LIB}/stereo_node_cpp" --ros-args \
      -p voc_file_arg:=${VOCABULARY} \
      -p settings_file_path_arg:=${CAMERA_CONFIG_DIR} \
      -p settings_name_arg:=${CAMERA_CONFIG_NAME} \
      -p left_topic:=${LEFT_TOPIC} \
      -p right_topic:=${RIGHT_TOPIC}
    exit $?
fi

# ── Stereo-Inertial mode (RealSense D435i VIO: stereo + IMU) ─────────────────
if [ "${SLAM_MODE}" = "stereo_inertial" ] || [ "${SLAM_MODE}" = "vio_stereo" ]; then
    echo "slam-launch: Stereo-Inertial  left=${LEFT_TOPIC} right=${RIGHT_TOPIC} imu=${IMU_TOPIC}  config=${CAMERA_CONFIG_DIR}${CAMERA_CONFIG_NAME}.yaml"
    "${LIB}/stereo_inertial_node_cpp" --ros-args \
      -p voc_file_arg:=${VOCABULARY} \
      -p settings_file_path_arg:=${CAMERA_CONFIG_DIR} \
      -p settings_name_arg:=${CAMERA_CONFIG_NAME} \
      -p left_topic:=${LEFT_TOPIC} \
      -p right_topic:=${RIGHT_TOPIC} \
      -p imu_topic:=${IMU_TOPIC}
    exit $?
fi

# ── Monocular mode (legacy) ──────────────────────────────────────────────────
MONO_CPP=/opt/orbslam3_ws/install/lib/ros2_orb_slam3/mono_node_cpp
MONO_DRIVER_PY=/opt/orbslam3_ws/install/lib/ros2_orb_slam3/mono_driver_node.py
ADAPTER=/usr/local/bin/rosbag-image-adapter.py

echo "slam-launch: mono mode  image=${IMAGE_TOPIC}"

"${MONO_CPP}" --ros-args \
  -p voc_file_arg:=${VOCABULARY} \
  -p settings_file_path_arg:=${CAMERA_CONFIG_DIR} &
cpp_pid=$!

python3 "${MONO_DRIVER_PY}" --ros-args \
  -p settings_name:=${CAMERA_CONFIG_NAME} \
  -p image_seq:=${CAMERA_CONFIG_NAME} &
driver_pid=$!

IMAGE_TOPIC=${IMAGE_TOPIC} python3 "${ADAPTER}" &
adapter_pid=$!

trap 'kill "${cpp_pid}" "${driver_pid}" "${adapter_pid}" 2>/dev/null || true' EXIT
wait -n "${cpp_pid}" "${driver_pid}" "${adapter_pid}"
